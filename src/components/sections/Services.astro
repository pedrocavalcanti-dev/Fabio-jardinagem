---
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import { servicesContent, servicesList } from '@/data/services';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';

const { ctaLabel, ...heading } = servicesContent;
---

<section id="servicos" class="section services" aria-labelledby="services-heading">
  <div class="container">
    <div class="carousel-heading" data-reveal>
      <SectionHeading id="services-heading" {...heading} />

      <div class="carousel-controls" aria-label="Navegação do carrossel de serviços">
        <button type="button" class="carousel-btn" data-carousel-prev="services" aria-controls="services-track" aria-label="Ver serviço anterior" disabled>
          <ChevronLeft size={20} stroke-width={2} />
        </button>
        <button type="button" class="carousel-btn carousel-btn--solid" data-carousel-next="services" aria-controls="services-track" aria-label="Ver próximo serviço" disabled>
          <ChevronRight size={20} stroke-width={2} />
        </button>
      </div>
    </div>

    <div
      class="carousel-track"
      id="services-track"
      data-carousel-track="services"
      tabindex="0"
      role="region"
      aria-label="Lista de serviços de jardinagem e paisagismo"
    >
      {servicesList.map((service) => <ServiceCard service={service} ctaLabel={ctaLabel} />)}
    </div>

    <div class="carousel-dots services__dots" data-carousel-dots="services" aria-hidden="true"></div>
  </div>
</section>

<style>
  .services {
    background-color: var(--color-surface-muted);
  }

  .services__dots {
    margin-top: var(--space-3);
  }
</style>
