---
import { Check } from '@lucide/astro';
import { siteConfig } from '@/config/site';
import ResponsivePhoto from '@/components/ui/ResponsivePhoto.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';

const { about } = siteConfig.sections;
---

<section id="sobre" class="section about" aria-labelledby="about-heading">
  <div class="container">
    <div class="about__grid">
      <!-- Composição fotográfica (imagem principal + sobreposição complementar) -->
      <div class="about__media" data-reveal>
        <div class="about__photo-main">
          <ResponsivePhoto
            src={about.mainImage}
            alt={about.mainAlt}
            widths={[480, 768, 960]}
            sizes="(max-width: 1024px) 100vw, 48vw"
            objectPosition={about.mainObjectPosition}
          />
          {about.isPlaceholder && (
            <span class="photo-placeholder-badge">Espaço para foto real do profissional</span>
          )}
        </div>

        {
          about.secondaryImage && (
            <div class="about__photo-secondary">
              <ResponsivePhoto
                src={about.secondaryImage}
                alt={about.secondaryAlt}
                widths={[320, 540]}
                sizes="(max-width: 768px) 42vw, 240px"
                objectPosition={about.secondaryObjectPosition}
              />
            </div>
          )
        }
      </div>

      <!-- Conteúdo institucional editável -->
      <div class="about__content" data-reveal>
        <SectionHeading
          id="about-heading"
          eyebrow={about.eyebrow}
          titleStart={about.titleStart}
          titleAccent={about.titleAccent}
        />

        <div class="about__paragraphs">
          {about.paragraphs.map((text) => <p>{text}</p>)}
        </div>

        <ul class="about__pillars">
          {
            about.pillars.map((pillar) => (
              <li class="about__pillar">
                <span class="about__pillar-icon" aria-hidden="true">
                  <Check size={15} stroke-width={2.5} />
                </span>
                <span>{pillar}</span>
              </li>
            ))
          }
        </ul>

        <div class="about__action">
          <WhatsAppButton
            message={siteConfig.whatsappMessages.about}
            label={about.ctaLabel}
            variant="primary"
            size="lg"
            icon="both"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  .about__media {
    position: relative;
    padding-bottom: var(--space-6);
  }

  .about__photo-main {
    position: relative;
    aspect-ratio: 4 / 4.6;
    width: 100%;
    max-width: 480px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-forest);
    box-shadow: var(--shadow-md);
  }

  .about__photo-secondary {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(132px, 38%, 210px);
    aspect-ratio: 4 / 4.6;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 6px solid var(--color-bg-warm);
    background: var(--color-natural);
    box-shadow: var(--shadow-md);
  }

  .about__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .about__paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    max-width: 56ch;
  }

  .about__pillars {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-1);
  }

  .about__pillar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-forest);
  }

  .about__pillar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-sage-tint);
    color: var(--color-natural);
    flex-shrink: 0;
  }

  .about__action {
    padding-top: var(--space-2);
  }

  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: 0.95fr 1.05fr;
      gap: var(--space-16);
    }

    .about__media {
      padding-right: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .about__photo-main {
      max-width: none;
    }
  }
</style>
