---
import { ChevronLeft, ChevronRight, X } from '@lucide/astro';
import { getImage } from 'astro:assets';
import { beforeAfterPairs, portfolioContent, portfolioItems } from '@/data/portfolio';
import { siteConfig } from '@/config/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import GalleryCard from '@/components/ui/GalleryCard.astro';
import BeforeAfterSlider from '@/components/ui/BeforeAfterSlider.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';

const ownWork = portfolioItems.filter((item) => item.isOwnWork);
const isIllustrative = ownWork.length === 0;
const items = isIllustrative ? portfolioItems : ownWork;
const content = isIllustrative ? portfolioContent.illustrative : portfolioContent.ownWork;
const categories = [...new Set(items.map((item) => item.category))];
const message = siteConfig.whatsappMessages.portfolio;

const lightboxData = await Promise.all(items.map(async ({ id, title, category, caption, image, alt }) => {
  const photo = await getImage({ src: image, width: Math.min(image.width, 960), format: 'webp', quality: 77 });
  return { id, title, category, caption, src: photo.src, alt };
}));
---

<section id="projetos" class="section portfolio" aria-labelledby="portfolio-heading">
  <div class="container">
    <div class="carousel-heading" data-reveal>
      <SectionHeading id="portfolio-heading" {...content} />
      {items.length > 1 && (
        <div class="carousel-controls" aria-label="Controles da galeria">
          <button type="button" class="carousel-btn" data-carousel-prev="portfolio" aria-controls="portfolio-track" aria-label="Ver foto anterior" disabled>
            <ChevronLeft size={20} stroke-width={2} />
          </button>
          <button type="button" class="carousel-btn carousel-btn--solid" data-carousel-next="portfolio" aria-controls="portfolio-track" aria-label="Ver próxima foto" disabled>
            <ChevronRight size={20} stroke-width={2} />
          </button>
        </div>
      )}
    </div>

    {!isIllustrative && categories.length > 1 && (
      <div class="portfolio__filters" role="group" aria-label="Filtrar projetos por categoria">
        {['Todos', ...categories].map((category, index) => (
          <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} class="portfolio__filter-btn" data-gallery-filter={category}>
            {category}
          </button>
        ))}
      </div>
    )}

    <div
      class="carousel-track"
      id="portfolio-track"
      data-carousel-track="portfolio"
      tabindex="0"
      role="region"
      aria-label={isIllustrative ? 'Galeria de inspiração' : 'Galeria de projetos'}
    >
      {items.map((item) => <GalleryCard item={item} />)}
    </div>

    <div class="portfolio__actions">
      <div class="carousel-dots" data-carousel-dots="portfolio" aria-hidden="true"></div>
      <div data-inline-cta>
        <WhatsAppButton message={message} label="Conversar sobre meu espaço" variant="outline-dark" size="sm" icon="whatsapp" />
      </div>
    </div>

    {beforeAfterPairs.length > 0 && (
      <div class="portfolio__before-after">
        <h3 class="portfolio__subhead">Transformações registradas</h3>
        <div class="portfolio__ba-grid">
          {beforeAfterPairs.map((pair) => <BeforeAfterSlider pair={pair} />)}
        </div>
      </div>
    )}
  </div>
</section>

<script
  type="application/json"
  id="portfolio-lightbox-data"
  set:html={JSON.stringify(lightboxData).replace(/</g, '\\u003c')}
/>

<dialog class="lightbox on-dark" aria-labelledby="lightbox-title" data-lightbox>
  <div class="lightbox__backdrop" data-lightbox-close></div>
  <div class="lightbox__shell">
    <div class="lightbox__topbar">
      <span class="lightbox__counter" data-lightbox-counter aria-live="polite"></span>
      <button type="button" class="lightbox__close" aria-label="Fechar visualização ampliada" data-lightbox-close autofocus>
        <X size={22} />
      </button>
    </div>

    <figure class="lightbox__figure">
      <div class="lightbox__media-wrap">
        <img alt="" class="lightbox__img" data-lightbox-img />
        <button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Imagem anterior" data-lightbox-prev>
          <ChevronLeft size={24} />
        </button>
        <button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Próxima imagem" data-lightbox-next>
          <ChevronRight size={24} />
        </button>
      </div>

      <figcaption class="lightbox__caption">
        <div class="lightbox__caption-copy">
          <span class="lightbox__category" data-lightbox-category></span>
          <h3 id="lightbox-title" class="lightbox__title" data-lightbox-title></h3>
          <p class="lightbox__desc" data-lightbox-desc></p>
        </div>
        <div class="lightbox__caption-cta">
          <WhatsAppButton message={message} label="Conversar sobre meu espaço" variant="lime" size="sm" icon="whatsapp" />
        </div>
      </figcaption>
    </figure>
  </div>
</dialog>

<style>
  .portfolio__filters,
  .portfolio__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .portfolio__filters {
    margin-bottom: var(--space-6);
  }

  .portfolio__actions {
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-3);
  }

  .portfolio__filter-btn {
    min-height: 44px;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-forest);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .portfolio__filter-btn[aria-pressed='true'],
  .portfolio__filter-btn:hover {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-surface);
  }

  .portfolio__before-after {
    margin-top: var(--space-12);
  }

  .portfolio__subhead {
    font-size: var(--text-2xl);
    color: var(--color-forest);
    margin-bottom: var(--space-6);
  }

  .portfolio__ba-grid {
    display: grid;
    gap: var(--space-6);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: max(var(--space-3), env(safe-area-inset-top)) var(--space-4)
      max(var(--space-3), env(safe-area-inset-bottom));
    border: 0;
    background: transparent;
    color: var(--color-surface);
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgba(11, 34, 26, 0.90);
    backdrop-filter: blur(8px);
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
  }

  .lightbox__shell {
    position: relative;
    width: min(100%, 940px);
    max-height: 100%;
    display: grid;
    grid-template-rows: auto minmax(min-content, 1fr);
    gap: var(--space-3);
    overflow: auto;
  }

  .lightbox__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .lightbox__counter {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .lightbox__figure {
    background: var(--color-forest-deep);
    border: 1px solid var(--color-border-inverse);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .lightbox__media-wrap {
    position: relative;
    height: clamp(110px, calc(100dvh - 270px), 560px);
    background: #081a14;
  }

  .lightbox__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .lightbox__caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .lightbox__category {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-lime);
  }

  .lightbox__title {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.3;
  }

  .lightbox__desc {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-inverse-soft);
  }

  .lightbox__close,
  .lightbox__nav {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border-inverse);
    border-radius: 50%;
    background: var(--color-forest-deep);
    color: var(--color-surface);
  }

  .lightbox__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__nav[hidden] {
    display: none;
  }

  .lightbox__nav--prev { left: var(--space-2); }
  .lightbox__nav--next { right: var(--space-2); }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: var(--color-lime);
    color: var(--color-forest);
  }

  @media (min-width: 640px) {
    .portfolio__ba-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lightbox__caption {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-4) var(--space-6);
    }
  }
</style>
