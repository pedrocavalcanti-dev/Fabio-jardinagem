---
import { ChevronLeft, ChevronRight, X } from '@lucide/astro';
import { beforeAfterPairs, portfolioContent, portfolioItems } from '@/data/portfolio';
import { buildWhatsAppUrl, isWhatsAppConfigured, siteConfig } from '@/config/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import GalleryCard from '@/components/ui/GalleryCard.astro';
import BeforeAfterSlider from '@/components/ui/BeforeAfterSlider.astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';

const hasOnlyPlaceholders = portfolioItems.every((item) => item.isPlaceholder);
const realCategories = Array.from(
  new Set(portfolioItems.filter((item) => !item.isPlaceholder).map((item) => item.category)),
);
const showFilters = portfolioContent.forceShowFilters || realCategories.length >= 2;
const filterCategories = showFilters
  ? ['Todos', ...Array.from(new Set(portfolioItems.map((item) => item.category)))]
  : [];

const lightboxPayload = portfolioItems.map((item) => {
  const message = siteConfig.whatsappMessages.portfolio(item.title);
  return {
    id: item.id,
    title: item.title,
    category: item.category,
    caption: item.caption,
    src: item.image.src,
    alt: item.alt,
    isPlaceholder: Boolean(item.isPlaceholder),
    whatsappMessage: message,
    whatsappUrl: buildWhatsAppUrl(message),
  };
});

const whatsappConfigured = isWhatsAppConfigured();
---

<section id="projetos" class="section portfolio" aria-labelledby="portfolio-heading">
  <div class="container">
    <div class="portfolio__header" data-reveal>
      <SectionHeading
        id="portfolio-heading"
        eyebrow={portfolioContent.eyebrow}
        titleStart={portfolioContent.titleStart}
        titleAccent={portfolioContent.titleAccent}
        description={portfolioContent.description}
      />

      <div class="portfolio__controls" aria-label="Controles da galeria">
        <button
          type="button"
          class="carousel-btn"
          data-carousel-prev="portfolio"
          aria-label="Ver foto anterior"
        >
          <ChevronLeft size={20} stroke-width={2} />
        </button>
        <button
          type="button"
          class="carousel-btn carousel-btn--solid"
          data-carousel-next="portfolio"
          aria-label="Ver próxima foto"
        >
          <ChevronRight size={20} stroke-width={2} />
        </button>
      </div>
    </div>

    {
      hasOnlyPlaceholders && (
        <p class="portfolio__notice" data-reveal>
          {portfolioContent.placeholderNotice}
        </p>
      )
    }

    {
      showFilters && (
        <div class="portfolio__filters" role="tablist" aria-label="Filtrar projetos por categoria">
          {filterCategories.map((category, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              class:list={['portfolio__filter-btn', idx === 0 && 'is-active']}
              data-gallery-filter={category}
            >
              {category}
            </button>
          ))}
        </div>
      )
    }

    <!-- Carrossel touch no mobile / grade editorial no desktop -->
    <div
      class="portfolio__grid"
      data-carousel-track="portfolio"
      tabindex="0"
      role="region"
      aria-label="Galeria de jardins e projetos"
    >
      {portfolioItems.map((item, index) => <GalleryCard item={item} index={index} />)}
    </div>

    <div class="portfolio__mobile-hint">
      <div class="carousel-dots" data-carousel-dots="portfolio" aria-hidden="true">
        {
          portfolioItems.map((_, index) => (
            <span class:list={['carousel-dots__item', index === 0 && 'is-active']} data-dot={index} />
          ))
        }
      </div>
      <span class="portfolio__swipe-label">Deslize ou toque para ampliar</span>
    </div>

    {
      beforeAfterPairs.length > 0 && (
        <div class="portfolio__before-after">
          <h3 class="portfolio__subhead">Transformações registradas</h3>
          <div class="portfolio__ba-grid">
            {beforeAfterPairs.map((pair) => (
              <BeforeAfterSlider pair={pair} />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<!-- Dados serializados para o Lightbox -->
<script
  type="application/json"
  id="portfolio-lightbox-data"
  set:html={JSON.stringify(lightboxPayload)}
/>

<!-- Modal Lightbox acessível -->
<div
  class="lightbox"
  id="gallery-lightbox"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-title"
  hidden
  data-lightbox
>
  <div class="lightbox__backdrop" data-lightbox-close />

  <div class="lightbox__shell">
    <div class="lightbox__topbar">
      <span class="lightbox__counter" data-lightbox-counter>1 / {portfolioItems.length}</span>
      <button
        type="button"
        class="lightbox__close"
        aria-label="Fechar visualização ampliada"
        data-lightbox-close
      >
        <X size={22} />
      </button>
    </div>

    <div class="lightbox__stage">
      <button
        type="button"
        class="lightbox__nav lightbox__nav--prev"
        aria-label="Imagem anterior"
        data-lightbox-prev
      >
        <ChevronLeft size={24} />
      </button>

      <figure class="lightbox__figure">
        <div class="lightbox__media-wrap">
          <img src="" alt="" class="lightbox__img" data-lightbox-img />
          <span class="photo-placeholder-badge" data-lightbox-placeholder hidden>
            Espaço para foto real
          </span>
        </div>

        <figcaption class="lightbox__caption">
          <div class="lightbox__caption-copy">
            <span class="lightbox__category" data-lightbox-category />
            <h3 id="lightbox-title" class="lightbox__title" data-lightbox-title />
            <p class="lightbox__desc" data-lightbox-desc />
          </div>

          <div class="lightbox__caption-cta">
            {
              whatsappConfigured ? (
                <a
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn--lime btn--sm"
                  data-lightbox-wa-link
                >
                  <WhatsAppIcon size={16} />
                  <span>Quero algo semelhante</span>
                </a>
              ) : (
                <button
                  type="button"
                  class="btn btn--lime btn--sm"
                  data-whatsapp-fallback
                  data-whatsapp-message=""
                  data-lightbox-wa-fallback
                >
                  <WhatsAppIcon size={16} />
                  <span>Quero algo semelhante</span>
                </button>
              )
            }
          </div>
        </figcaption>
      </figure>

      <button
        type="button"
        class="lightbox__nav lightbox__nav--next"
        aria-label="Próxima imagem"
        data-lightbox-next
      >
        <ChevronRight size={24} />
      </button>
    </div>
  </div>
</div>

<style>
  .portfolio__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .portfolio__controls {
    display: none;
    align-items: center;
    gap: var(--space-2);
  }

  .portfolio__notice {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.65rem 1rem;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-sage-tint);
    border: 1px solid var(--color-sage-soft);
    font-size: var(--text-xs);
    color: var(--color-forest);
    line-height: 1.5;
  }

  .portfolio__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .portfolio__filter-btn {
    min-height: 40px;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-forest);
    font-size: var(--text-xs);
    font-weight: 600;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .portfolio__filter-btn.is-active,
  .portfolio__filter-btn:hover {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-surface);
  }

  /* Mobile: carrossel horizontal otimizado para toque */
  .portfolio__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 84%);
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
    -webkit-overflow-scrolling: touch;
  }

  .portfolio__grid::-webkit-scrollbar {
    display: none;
  }

  .portfolio__mobile-hint {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .portfolio__swipe-label {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .portfolio__before-after {
    margin-top: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .portfolio__subhead {
    font-size: var(--text-2xl);
    color: var(--color-forest);
  }

  .portfolio__ba-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  /* Botões compartilhados com Services */
  .carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-forest);
    transition:
      background-color var(--transition-fast),
      opacity var(--transition-fast);
  }

  .carousel-btn:hover:not(:disabled) {
    background: var(--color-sage-tint);
  }

  .carousel-btn--solid {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-surface);
  }

  .carousel-btn--solid:hover:not(:disabled) {
    background: var(--color-natural);
  }

  .carousel-btn:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .carousel-dots__item {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: rgba(16, 47, 37, 0.2);
    transition:
      width var(--transition-fast),
      background-color var(--transition-fast);
  }

  .carousel-dots__item.is-active {
    width: 24px;
    background: var(--color-forest);
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 34, 26, 0.88);
    backdrop-filter: blur(8px);
  }

  .lightbox__shell {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 980px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .lightbox__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-surface);
  }

  .lightbox__counter {
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.82);
  }

  .lightbox__close {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-surface);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lightbox__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-4);
  }

  .lightbox__figure {
    background: var(--color-forest-deep);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .lightbox__media-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #081a14;
    max-height: 62svh;
    overflow: hidden;
  }

  .lightbox__img {
    width: 100%;
    max-height: 62svh;
    object-fit: contain;
  }

  .lightbox__caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    color: var(--color-surface);
  }

  .lightbox__caption-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .lightbox__category {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-lime);
  }

  .lightbox__title {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .lightbox__desc {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.5;
  }

  .lightbox__nav {
    position: absolute;
    top: 32%;
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(11, 34, 26, 0.72);
    color: var(--color-surface);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__nav--prev {
    left: var(--space-3);
  }

  .lightbox__nav--next {
    right: var(--space-3);
  }

  .lightbox__nav:hover {
    background: var(--color-lime);
    color: var(--color-forest);
    border-color: var(--color-lime);
  }

  @media (min-width: 640px) {
    .portfolio__grid {
      grid-auto-columns: calc((100% - var(--space-5)) / 2);
      gap: var(--space-5);
    }
  }

  @media (min-width: 768px) {
    .portfolio__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .portfolio__controls {
      display: flex;
    }

    .lightbox__caption {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-5) var(--space-6);
    }

    .lightbox__caption-cta {
      flex-shrink: 0;
    }

    .portfolio__ba-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    /* Desktop: galeria editorial navegável com 3 colunas e alturas variadas */
    .portfolio__grid {
      grid-auto-columns: calc((100% - var(--space-6) * 2) / 3);
      gap: var(--space-6);
      align-items: start;
    }

    .portfolio__mobile-hint {
      justify-content: flex-start;
    }

    .portfolio__swipe-label {
      display: none;
    }

    .lightbox__stage {
      grid-template-columns: auto 1fr auto;
    }

    .lightbox__nav {
      position: static;
      width: 50px;
      height: 50px;
    }
  }
</style>
