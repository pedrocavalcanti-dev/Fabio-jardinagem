---
import { ChevronDown } from '@lucide/astro';
import { faqContent, faqItems } from '@/data/faq';
import { siteConfig } from '@/config/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
---

<section id="duvidas" class="section faq" aria-labelledby="faq-heading">
  <div class="container">
    <div class="faq__grid">
      <div class="faq__intro" data-reveal>
        <SectionHeading
          id="faq-heading"
          eyebrow={faqContent.eyebrow}
          titleStart={faqContent.titleStart}
          titleAccent={faqContent.titleAccent}
          description={faqContent.description}
        />

        <div class="faq__cta">
          <WhatsAppButton
            message={siteConfig.whatsappMessages.footer}
            label={faqContent.helperCtaLabel}
            variant="outline-dark"
            size="md"
            icon="whatsapp"
          />
        </div>
      </div>

      <div class="faq__list" data-faq-accordion data-reveal>
        {
          faqItems.map((item, index) => {
            const triggerId = `faq-trigger-${item.id}`;
            const panelId = `faq-panel-${item.id}`;
            const isOpen = index === 0;

            return (
              <article class:list={['faq-item', isOpen && 'is-open']} data-faq-item>
                <h3 class="faq-item__heading">
                  <button
                    type="button"
                    id={triggerId}
                    class="faq-item__trigger"
                    aria-expanded={isOpen ? 'true' : 'false'}
                    aria-controls={panelId}
                    data-faq-trigger
                  >
                    <span>{item.question}</span>
                    <span class="faq-item__icon" aria-hidden="true">
                      <ChevronDown size={18} stroke-width={2.2} />
                    </span>
                  </button>
                </h3>

                <div
                  id={panelId}
                  role="region"
                  aria-labelledby={triggerId}
                  class="faq-item__panel"
                  hidden={!isOpen}
                  data-faq-panel
                >
                  <p class="faq-item__answer">{item.answer}</p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .faq__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .faq-item.is-open {
    border-color: var(--color-sage-soft);
    box-shadow: var(--shadow-xs);
  }

  .faq-item__heading {
    font-size: inherit;
    font-weight: inherit;
  }

  .faq-item__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding: var(--space-4) var(--space-5);
    border: 0;
    background: transparent;
    text-align: left;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-forest);
    line-height: 1.4;
  }

  .faq-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-sage-tint);
    color: var(--color-natural);
    flex-shrink: 0;
    transition:
      transform var(--transition-fast),
      background-color var(--transition-fast);
  }

  .faq-item.is-open .faq-item__icon {
    transform: rotate(180deg);
    background: var(--color-forest);
    color: var(--color-lime);
  }

  .faq-item__panel {
    padding: 0 var(--space-5) var(--space-5);
  }

  .faq-item__panel[hidden] {
    display: none;
  }

  .faq-item__answer {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  @media (min-width: 1024px) {
    .faq__grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-14);
    }

    .faq__intro {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }
  }
</style>
