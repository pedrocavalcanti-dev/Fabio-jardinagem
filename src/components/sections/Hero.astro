---
import { ArrowDown, Leaf } from '@lucide/astro';
import { siteConfig } from '@/config/site';
import ResponsivePhoto from '@/components/ui/ResponsivePhoto.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';

const { hero } = siteConfig.sections;
---

<section id="inicio" class="hero" aria-labelledby="hero-heading">
  <div class="container-wide">
    <div class="hero__frame on-dark">
      <!-- Imagens de fundo (suporte dedicado para desktop e mobile) -->
      <div class="hero__media" aria-hidden="true">
        <div class="hero__media-desktop">
          <ResponsivePhoto
            src={hero.desktopImage}
            alt={hero.desktopAlt}
            widths={[960, 1440, 1920]}
            sizes="100vw"
            objectPosition={hero.desktopObjectPosition}
            priority
          />
        </div>
        <div class="hero__media-mobile">
          <ResponsivePhoto
            src={hero.mobileImage}
            alt={hero.mobileAlt}
            widths={[480, 768, 1080]}
            sizes="100vw"
            objectPosition={hero.mobileObjectPosition}
            priority
          />
        </div>
        <div class="hero__overlay"></div>
      </div>

      {hero.isPlaceholder && (
        <span class="photo-placeholder-badge hero__placeholder">
          Espaço para foto real do hero
        </span>
      )}

      <div class="hero__content">
        <div class="hero__text">
          <p class="hero__eyebrow">
            <Leaf size={14} stroke-width={2.2} aria-hidden="true" />
            <span>{hero.eyebrow}</span>
          </p>

          <h1 id="hero-heading" class="hero__title">
            {hero.titleStart}
            <br />
            <span class="editorial-accent hero__accent">{hero.titleAccent}</span>{' '}
            {hero.titleEnd}
          </h1>

          <p class="hero__desc">{hero.description}</p>

          <div class="hero__actions" data-hero-cta>
            <WhatsAppButton
              message={siteConfig.whatsappMessages.hero}
              label={hero.primaryCta}
              variant="lime"
              size="lg"
              icon="both"
            />
            <a href="#servicos" class="btn btn--outline-light btn--lg">
              <span>{hero.secondaryCta}</span>
              <ArrowDown size={16} stroke-width={2} aria-hidden="true" />
            </a>
          </div>
        </div>

        <!-- Elemento discreto sem métricas inventadas -->
        <aside class="hero__note" aria-label="Resumo do atendimento">
          <span class="hero__note-dot" aria-hidden="true"></span>
          <div>
            <p class="hero__note-label">{hero.noteLabel}</p>
            <p class="hero__note-text">{hero.noteText}</p>
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--space-3) + 4px);
    padding-bottom: var(--space-4);
  }

  .hero__frame {
    position: relative;
    min-height: clamp(560px, 84svh, 680px);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-forest);
    display: flex;
    align-items: flex-end;
    box-shadow: var(--shadow-md);
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media-desktop {
    display: none;
    width: 100%;
    height: 100%;
  }

  .hero__media-mobile {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(11, 34, 26, 0.42) 0%,
        rgba(11, 34, 26, 0.34) 36%,
        rgba(11, 34, 26, 0.84) 84%,
        rgba(11, 34, 26, 0.94) 100%
      );
  }

  .hero__placeholder {
    top: 96px;
    left: var(--space-6);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 7.25rem var(--space-6) var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 760px;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.42rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-lime);
  }

  .hero__title {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    color: var(--color-surface);
    text-wrap: balance;
  }

  .hero__accent {
    color: var(--color-lime);
    font-weight: 500;
  }

  .hero__desc {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
    max-width: 48ch;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .hero__actions :global(.btn) {
    width: 100%;
  }

  .hero__note {
    display: none;
  }

  @media (min-width: 540px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }

    .hero__actions :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 768px) {
    .hero__media-desktop {
      display: block;
    }

    .hero__media-mobile {
      display: none;
    }

    .hero__frame {
      min-height: clamp(600px, 82svh, 740px);
      border-radius: var(--radius-2xl);
    }

    .hero__overlay {
      background:
        linear-gradient(
          90deg,
          rgba(11, 34, 26, 0.86) 0%,
          rgba(11, 34, 26, 0.62) 52%,
          rgba(11, 34, 26, 0.24) 100%
        ),
        linear-gradient(180deg, rgba(11, 34, 26, 0.32) 0%, rgba(11, 34, 26, 0.14) 40%, rgba(11, 34, 26, 0.72) 100%);
    }

    .hero__content {
      padding: 8rem var(--space-10) var(--space-10);
    }

    .hero__placeholder {
      top: 96px;
      left: auto;
      right: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: var(--space-4);
    }

    .hero__content {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      padding: 9rem var(--space-12) var(--space-12);
    }

    .hero__note {
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
      max-width: 280px;
      padding: var(--space-4) var(--space-5);
      border-radius: var(--radius-lg);
      background: rgba(16, 47, 37, 0.56);
      border: 1px solid rgba(255, 255, 255, 0.16);
      backdrop-filter: blur(12px);
    }

    .hero__note-dot {
      width: 9px;
      height: 9px;
      margin-top: 6px;
      border-radius: 50%;
      background: var(--color-lime);
      flex-shrink: 0;
    }

    .hero__note-label {
      font-size: var(--text-sm);
      font-weight: 700;
      color: var(--color-surface);
      line-height: 1.3;
    }

    .hero__note-text {
      font-size: var(--text-xs);
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.45;
      margin-top: 2px;
    }
  }
</style>
