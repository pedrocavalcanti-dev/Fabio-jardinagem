---
import { ArrowDown, Leaf } from '@lucide/astro';
import { siteConfig } from '@/config/site';
import ResponsivePhoto from '@/components/ui/ResponsivePhoto.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';

const { hero } = siteConfig.sections;
---

<section id="inicio" class="hero" aria-labelledby="hero-heading">
  <div class="container-wide">
    <div class="hero__frame on-dark">
      <div class="hero__media">
        <ResponsivePhoto
          src={hero.heroMobile}
          alt={hero.alt}
          widths={[480, 720, 960]}
          sizes="(max-width: 400px) calc(100vw - 2rem), 92vw"
          objectPosition={hero.focalPointMobile}
          desktop={{
            src: hero.heroDesktop,
            widths: [960, 1360, 1920],
            sizes: '(min-width: 1384px) 1320px, 94vw',
            objectPosition: hero.focalPointDesktop,
          }}
          quality={71}
          priority
        />
        <div class="hero__overlay"></div>
      </div>

      <div class="hero__content">
        <div class="hero__text">
          <p class="hero__eyebrow">
            <Leaf size={14} stroke-width={2.2} aria-hidden="true" />
            <span>{hero.eyebrow}</span>
          </p>

          <h1 id="hero-heading" class="hero__title">
            {hero.titleStart}{' '}
            <span class="editorial-accent hero__accent">{hero.titleAccent}</span>
          </h1>

          <p class="hero__desc">{hero.description}</p>

          <div class="hero__actions" data-hero-cta>
            <WhatsAppButton
              message={siteConfig.whatsappMessages.hero}
              label={hero.primaryCta}
              variant="lime"
              size="lg"
              icon="whatsapp"
            />
            <a href="#servicos" class="btn btn--outline-light btn--lg">
              <span>{hero.secondaryCta}</span>
              <ArrowDown size={16} stroke-width={2} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--space-3) + 4px);
    padding-bottom: var(--space-4);
  }

  .hero__frame {
    position: relative;
    min-height: clamp(550px, 87svh, 720px);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-forest);
    display: flex;
    align-items: flex-end;
    box-shadow: var(--shadow-md);
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(11, 34, 26, 0.12) 16%,
        rgba(11, 34, 26, 0.35) 37%,
        rgba(11, 34, 26, 0.86) 66%,
        rgba(11, 34, 26, 0.97) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 9rem clamp(1rem, 5vw, 1.75rem) var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 640px;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.42rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-lime);
  }

  .hero__title {
    font-size: clamp(2rem, 1.2rem + 4vw, 4.15rem);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    color: var(--color-surface);
    text-wrap: balance;
  }

  .hero__accent {
    color: var(--color-lime);
    font-weight: 500;
  }

  .hero__desc {
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.2rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
    max-width: 48ch;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .hero__actions :global(.btn) {
    width: 100%;
    padding-inline: var(--space-4);
  }

  @media (min-width: 540px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }

    .hero__actions :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 768px) {
    .hero__frame {
      min-height: clamp(580px, 83svh, 760px);
      border-radius: var(--radius-2xl);
    }

    .hero__overlay {
      background:
        linear-gradient(
          90deg,
          rgba(11, 34, 26, 0.88) 0%,
          rgba(11, 34, 26, 0.55) 40%,
          rgba(11, 34, 26, 0.05) 79%
        ),
        linear-gradient(180deg, rgba(11, 34, 26, 0.04) 28%, rgba(11, 34, 26, 0.44) 100%);
    }

    .hero__content {
      padding: 8rem var(--space-10) var(--space-10);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: var(--space-4);
    }

    .hero__content {
      padding: 9rem clamp(3rem, 5.2vw, 5rem) clamp(3rem, 5.2vw, 5rem);
    }
  }
</style>
