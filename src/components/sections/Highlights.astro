---
import { MessageCircle, Sparkles, Sprout } from '@lucide/astro';
import { siteConfig } from '@/config/site';

const { highlights } = siteConfig.sections;
---

<section class="highlights" aria-label="Diferenciais do atendimento">
  <div class="container">
    <ul class="highlights__grid">
      {
        highlights.map((item) => (
          <li class="highlights__item" data-reveal>
            <span class="highlights__icon" aria-hidden="true">
              {item.icon === 'message-circle' && <MessageCircle size={20} stroke-width={1.9} />}
              {item.icon === 'sparkles' && <Sparkles size={20} stroke-width={1.9} />}
              {item.icon === 'sprout' && <Sprout size={20} stroke-width={1.9} />}
            </span>
            <div class="highlights__copy">
              <h2 class="highlights__title">{item.title}</h2>
              <p class="highlights__desc">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .highlights {
    padding-block: var(--space-4) var(--space-6);
  }

  .highlights__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-xs);
  }

  .highlights__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
  }

  .highlights__item + .highlights__item {
    border-top: 1px solid var(--color-border-subtle);
    border-radius: 0;
    padding-top: var(--space-4);
  }

  .highlights__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--color-sage-tint);
    color: var(--color-natural);
    flex-shrink: 0;
  }

  .highlights__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .highlights__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-forest);
    line-height: 1.3;
  }

  .highlights__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.48;
  }

  @media (min-width: 768px) {
    .highlights {
      padding-block: var(--space-5) var(--space-8);
    }

    .highlights__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      padding: var(--space-5);
    }

    .highlights__item {
      padding: var(--space-3) var(--space-5);
    }

    .highlights__item + .highlights__item {
      border-top: 0;
      border-left: 1px solid var(--color-border-subtle);
      padding-top: var(--space-3);
    }
  }
</style>
