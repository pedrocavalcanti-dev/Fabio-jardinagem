---
import { Menu, X } from '@lucide/astro';
import { siteConfig } from '@/config/site';
import BrandLogo from '@/components/ui/BrandLogo.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
---

<header class="site-header" data-site-header data-scrolled="false">
  <div class="site-header__inner container-wide">
    <div class="site-header__bar">
      <div class="site-header__brand">
        <BrandLogo variant="dark" />
      </div>

      <nav class="site-header__nav" aria-label="Navegação principal">
        <ul class="site-header__list">
          {
            siteConfig.navigation.map((item) => (
              <li>
                <a href={item.href} class="site-header__link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-header__cta">
        <WhatsAppButton
          message={siteConfig.whatsappMessages.header}
          label="Solicitar orçamento"
          variant="lime"
          size="sm"
          icon="arrow"
        />
      </div>

      <button
        type="button"
        class="site-header__menu-btn"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        data-menu-toggle
      >
        <Menu size={22} stroke-width={2} />
      </button>
    </div>
  </div>
</header>

<!-- Painel de navegação mobile -->
<div class="mobile-nav" id="mobile-nav-drawer" hidden data-mobile-nav>
  <div class="mobile-nav__backdrop" data-menu-close />
  <div class="mobile-nav__panel" role="dialog" aria-modal="true" aria-label="Menu de navegação">
    <div class="mobile-nav__top">
      <BrandLogo variant="dark" showSubtitle={false} />
      <button
        type="button"
        class="mobile-nav__close"
        aria-label="Fechar menu"
        data-menu-close
      >
        <X size={22} stroke-width={2} />
      </button>
    </div>

    <nav class="mobile-nav__links" aria-label="Menu mobile">
      <ul>
        {
          siteConfig.navigation.map((item) => (
            <li>
              <a href={item.href} class="mobile-nav__link" data-mobile-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mobile-nav__footer">
      <WhatsAppButton
        message={siteConfig.whatsappMessages.header}
        label="Solicitar orçamento"
        variant="lime"
        size="lg"
        icon="both"
        fullWidth
      />
      <p class="mobile-nav__hint">Atendimento direto pelo WhatsApp.</p>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    padding-top: calc(var(--space-4) + 6px);
    transition: padding var(--transition-base);
    pointer-events: none;
  }

  .site-header__inner {
    pointer-events: auto;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
    margin-inline: var(--space-3);
    padding: 0.42rem 0.55rem 0.42rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(16, 47, 37, 0.08);
    backdrop-filter: blur(14px);
    box-shadow: 0 8px 28px rgba(16, 47, 37, 0.12);
    transition:
      margin var(--transition-base),
      background-color var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .site-header[data-scrolled='true'] {
    padding-top: var(--space-3);
  }

  .site-header[data-scrolled='true'] .site-header__bar {
    margin-inline: 0;
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(16, 47, 37, 0.12);
    box-shadow: 0 10px 30px rgba(16, 47, 37, 0.12);
  }

  .site-header__brand {
    flex-shrink: 0;
  }

  .site-header__nav,
  .site-header__cta {
    display: none;
  }

  .site-header__menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-border-subtle);
    background: var(--color-sage-tint);
    color: var(--color-forest);
    flex-shrink: 0;
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .site-header__menu-btn:hover {
    background: var(--color-lime);
  }

  /* Painel mobile */
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
    display: flex;
    justify-content: flex-end;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 34, 26, 0.56);
    backdrop-filter: blur(4px);
  }

  .mobile-nav__panel {
    position: relative;
    z-index: 1;
    width: min(88vw, 360px);
    height: 100%;
    padding: var(--space-5);
    padding-bottom: max(var(--space-6), env(safe-area-inset-bottom));
    background: var(--color-bg-warm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    box-shadow: var(--shadow-lg);
    overflow-y: auto;
  }

  .mobile-nav__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mobile-nav__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface);
    color: var(--color-forest);
  }

  .mobile-nav__links ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-nav__link {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-forest);
    transition: background-color var(--transition-fast);
  }

  .mobile-nav__link:hover,
  .mobile-nav__link:active {
    background: var(--color-sage-tint);
  }

  .mobile-nav__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .mobile-nav__hint {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-align: center;
  }

  @media (min-width: 1024px) {
    .site-header {
      padding-top: var(--space-8);
    }

    .site-header[data-scrolled='true'] {
      padding-top: var(--space-3);
    }

    .site-header__bar {
      margin-inline: var(--space-6);
      padding: 0.45rem 0.55rem 0.45rem 1.15rem;
    }

    .site-header[data-scrolled='true'] .site-header__bar {
      margin-inline: 0;
    }

    .site-header__nav {
      display: block;
    }

    .site-header__list {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .site-header__link {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 0.45rem 0.9rem;
      border-radius: var(--radius-pill);
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-text-primary);
      transition:
        background-color var(--transition-fast),
        color var(--transition-fast);
    }

    .site-header__link:hover {
      background-color: var(--color-sage-tint);
      color: var(--color-forest);
    }

    .site-header__cta {
      display: block;
      flex-shrink: 0;
    }

    .site-header__menu-btn {
      display: none;
    }
  }
</style>
