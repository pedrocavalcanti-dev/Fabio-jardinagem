---
import { buildWhatsAppUrl, siteConfig } from '@/config/site';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';

const floatMessage = siteConfig.whatsappMessages.floating;
const floatUrl = buildWhatsAppUrl(floatMessage);
---

<!-- Barra inferior fixa discreta para conversão no mobile (< 1024px) -->
<div
  class="mobile-cta-bar"
  data-mobile-cta-bar
  data-visible="false"
  role="region"
  aria-label="Orçamento rápido pelo WhatsApp"
>
  <div class="mobile-cta-bar__inner">
    <div class="mobile-cta-bar__text">
      <span class="mobile-cta-bar__title">Cuide do seu jardim</span>
      <span class="mobile-cta-bar__sub">Pelo WhatsApp</span>
    </div>
    <WhatsAppButton
      message={floatMessage}
      label="Pedir orçamento"
      variant="lime"
      size="sm"
      icon="whatsapp"
    />
  </div>
</div>

<!-- Botão flutuante discreto de WhatsApp no desktop (>= 1024px) -->
<div class="desktop-whatsapp-float" data-desktop-wa-float data-visible="false">
  <span class="desktop-whatsapp-float__tooltip" aria-hidden="true">Pedir orçamento</span>
  {
    floatUrl ? (
      <a
        href={floatUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="desktop-whatsapp-float__fab"
        aria-label="Pedir orçamento pelo WhatsApp"
      >
        <WhatsAppIcon size={24} />
      </a>
    ) : (
      <button
        type="button"
        class="desktop-whatsapp-float__fab"
        aria-label="Pedir orçamento pelo WhatsApp"
        data-whatsapp-fallback
        data-whatsapp-message={floatMessage}
      >
        <WhatsAppIcon size={24} />
      </button>
    )
  }
</div>

<style>
  .mobile-cta-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-mobile-bar);
    padding: 0.65rem var(--container-px) calc(0.65rem + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.96);
    border-top: 1px solid var(--color-border-subtle);
    backdrop-filter: blur(14px);
    box-shadow: 0 -8px 24px rgba(16, 47, 37, 0.08);
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
  }

  .mobile-cta-bar[data-visible='true'] {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-cta-bar :global(.btn) {
    min-height: 44px;
  }

  /* Nunca competir com menu mobile ou lightbox abertos */
  :global(body.has-overlay-open) .mobile-cta-bar,
  :global(body.has-overlay-open) .desktop-whatsapp-float {
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-cta-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: 540px;
    margin-inline: auto;
  }

  .mobile-cta-bar__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .mobile-cta-bar__title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-forest);
    line-height: 1.2;
  }

  .mobile-cta-bar__sub {
    font-size: 0.72rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Em telas muito estreitas (320px), mantém layout limpo e confortável */
  @media (max-width: 350px) {
    .mobile-cta-bar__sub {
      display: none;
    }
  }

  .desktop-whatsapp-float {
    display: none;
  }

  @media (min-width: 1024px) {
    .mobile-cta-bar {
      display: none;
    }

    .desktop-whatsapp-float {
      position: fixed;
      right: var(--space-6);
      bottom: var(--space-6);
      z-index: var(--z-sticky);
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      opacity: 0;
      visibility: hidden;
      transform: translateY(16px);
      pointer-events: none;
      transition:
        opacity var(--transition-base),
        transform var(--transition-base);
    }

    .desktop-whatsapp-float[data-visible='true'] {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .desktop-whatsapp-float__tooltip {
      padding: 0.5rem 0.9rem;
      border-radius: var(--radius-pill);
      background: var(--color-surface);
      color: var(--color-forest);
      border: 1px solid var(--color-border-subtle);
      box-shadow: var(--shadow-sm);
      font-size: var(--text-xs);
      font-weight: 600;
      opacity: 0;
      transform: translateX(8px);
      pointer-events: none;
      transition:
        opacity var(--transition-fast),
        transform var(--transition-fast);
    }

    .desktop-whatsapp-float:hover .desktop-whatsapp-float__tooltip,
    .desktop-whatsapp-float:focus-within .desktop-whatsapp-float__tooltip {
      opacity: 1;
      transform: translateX(0);
    }

    .desktop-whatsapp-float__fab {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      border: 2px solid rgba(197, 242, 122, 0.45);
      background: var(--color-forest);
      color: var(--color-lime);
      box-shadow: 0 12px 28px rgba(16, 47, 37, 0.28);
      transition:
        background-color var(--transition-fast),
        color var(--transition-fast),
        transform var(--transition-fast),
        box-shadow var(--transition-fast);
    }

    .desktop-whatsapp-float__fab:hover {
      background: var(--color-lime);
      color: var(--color-forest);
      border-color: var(--color-forest);
      transform: translateY(-2px) scale(1.03);
      box-shadow: 0 16px 34px rgba(16, 47, 37, 0.32);
    }
  }
</style>
