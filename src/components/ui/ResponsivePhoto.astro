---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface PhotoSource {
  src: ImageMetadata;
  widths: number[];
  sizes: string;
  objectPosition: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  objectPosition?: string;
  desktop?: PhotoSource;
  quality?: number;
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  widths = [480, 768, 1200],
  sizes = '(max-width: 768px) 100vw, 50vw',
  objectPosition = 'center',
  desktop,
  quality = 78,
  priority = false,
  class: className,
} = Astro.props;

const imageOptions = (source: ImageMetadata, candidates: number[]) =>
  source.format === 'svg'
    ? {}
    : {
        width: Math.min(source.width, candidates[Math.floor(candidates.length / 2)]),
        widths: candidates,
        format: 'webp' as const,
        quality,
      };

const desktopImage = desktop && (await getImage({
  src: desktop.src,
  ...imageOptions(desktop.src, desktop.widths),
}));
const photo = {
  ...imageOptions(src, widths),
  src,
  alt,
  sizes,
  loading: priority ? 'eager' as const : 'lazy' as const,
  fetchpriority: priority ? 'high' as const : 'auto' as const,
  decoding: priority ? 'sync' as const : 'async' as const,
  class: ['responsive-photo', className].filter(Boolean).join(' '),
  style: `--photo-position: ${objectPosition}; --photo-position-desktop: ${desktop?.objectPosition ?? objectPosition};`,
};
---

{
  desktop && desktopImage ? (
    <picture class="responsive-picture">
      <source
        media="(min-width: 768px)"
        srcset={desktopImage.srcSet.attribute || desktopImage.src}
        sizes={desktop.sizes}
        width={desktop.src.width}
        height={desktop.src.height}
      />
      <Image {...photo} />
    </picture>
  ) : (
    <Image {...photo} />
  )
}

<style>
  .responsive-picture,
  .responsive-photo {
    display: block;
    width: 100%;
    height: 100%;
  }

  .responsive-photo {
    object-fit: cover;
    object-position: var(--photo-position);
  }

  @media (min-width: 768px) {
    .responsive-photo {
      object-position: var(--photo-position-desktop);
    }
  }
</style>
