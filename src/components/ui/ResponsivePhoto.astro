---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  objectPosition?: string;
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  widths = [480, 768, 1200],
  sizes = '(max-width: 768px) 100vw, 50vw',
  objectPosition = 'center center',
  priority = false,
  class: className,
} = Astro.props;

const isSvg = src.format === 'svg';
---

{
  isSvg ? (
    <Image
      src={src}
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      class:list={['responsive-photo', className]}
      style={`object-position: ${objectPosition};`}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={82}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      class:list={['responsive-photo', className]}
      style={`object-position: ${objectPosition};`}
    />
  )
}

<style>
  .responsive-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
