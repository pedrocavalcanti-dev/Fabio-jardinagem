---
import { Expand } from '@lucide/astro';
import type { PortfolioItem } from '@/data/portfolio';
import ResponsivePhoto from './ResponsivePhoto.astro';

interface Props {
  item: PortfolioItem;
}

const { item } = Astro.props;
---

<figure
  class="gallery-card"
  data-gallery-item
  data-category={item.category}
>
  <button
    type="button"
    class="gallery-card__trigger"
    data-lightbox-open={item.id}
    aria-label={`Ampliar fotografia: ${item.title}`}
  >
    <span class="gallery-card__frame">
      <ResponsivePhoto
        src={item.image}
        alt={item.alt}
        widths={[384, 640, 960]}
        sizes="(max-width: 639px) 83vw, (max-width: 1023px) 46vw, 385px"
        objectPosition={item.objectPosition ?? 'center center'}
        class="gallery-card__img"
      />
      <span class="gallery-card__scrim" aria-hidden="true"></span>

      <span class="gallery-card__zoom" aria-hidden="true">
        <Expand size={16} stroke-width={2} />
      </span>

      <span class="gallery-card__meta">
        <span class="gallery-card__category">{item.category}</span>
        <span class="gallery-card__title">{item.title}</span>
      </span>
    </span>
  </button>
</figure>

<style>
  .gallery-card {
    position: relative;
    margin: 0;
    scroll-snap-align: start;
  }

  .gallery-card[hidden] {
    display: none;
  }

  .gallery-card__trigger {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    border-radius: var(--radius-xl);
  }

  .gallery-card__frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-forest);
    box-shadow: var(--shadow-xs);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  .gallery-card__trigger:hover .gallery-card__frame {
    box-shadow: var(--shadow-md);
  }

  .gallery-card__img {
    position: absolute;
    inset: 0;
    transition: transform 620ms var(--ease-out);
  }

  .gallery-card__trigger:hover .gallery-card__img {
    transform: scale(1.045);
  }

  .gallery-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 40%,
      rgba(11, 34, 26, 0.92) 100%
    );
    transition: opacity var(--transition-fast);
  }

  .gallery-card__zoom {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-forest);
    box-shadow: var(--shadow-xs);
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .gallery-card__trigger:hover .gallery-card__zoom {
    background-color: var(--color-lime);
    transform: scale(1.06);
  }

  .gallery-card__meta {
    position: absolute;
    inset-inline: var(--space-5);
    bottom: var(--space-5);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--color-surface);
  }

  .gallery-card__category {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-lime);
  }

  .gallery-card__title {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-surface);
  }

  .gallery-card__trigger:focus-visible {
    outline-offset: -3px;
  }
</style>
