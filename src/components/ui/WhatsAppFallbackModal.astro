---
import { Check, Copy, X } from '@lucide/astro';
import { isWhatsAppConfigured } from '@/config/site';

const configured = isWhatsAppConfigured();
---

{
  !configured && (
    <dialog class="wa-modal" id="whatsapp-fallback-modal" aria-labelledby="wa-modal-title">
      <div class="wa-modal__backdrop" data-wa-modal-close />
      <div class="wa-modal__dialog">
        <button
          type="button"
          class="wa-modal__close"
          data-wa-modal-close
          aria-label="Fechar aviso"
          autofocus
        >
          <X size={20} />
        </button>

        <h3 id="wa-modal-title" class="wa-modal__title">
          Contato pelo WhatsApp
        </h3>

        <p class="wa-modal__text">
          O número de atendimento ainda está pendente. Você pode copiar a mensagem para usar quando tiver o contato.
        </p>

        <blockquote class="wa-modal__preview" data-wa-modal-message />

        <div class="wa-modal__actions">
          <button type="button" class="btn btn--primary btn--sm" data-wa-copy-message>
            <span data-copy-icon aria-hidden="true"><Copy size={15} /></span>
            <span data-copied-icon aria-hidden="true" hidden><Check size={15} /></span>
            <span data-copy-label>Copiar mensagem</span>
          </button>
          <button type="button" class="btn btn--outline-dark btn--sm" data-wa-modal-close>
            Fechar
          </button>
        </div>
      </div>
    </dialog>
  )
}

<style>
  .wa-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    background: transparent;
    padding: var(--space-4);
  }

  .wa-modal[open] {
    display: grid;
    place-items: center;
  }

  .wa-modal::backdrop {
    background: rgba(11, 34, 26, 0.72);
    backdrop-filter: blur(4px);
  }

  .wa-modal__backdrop {
    position: absolute;
    inset: 0;
  }

  .wa-modal__dialog {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 480px;
    max-height: 100%;
    overflow: auto;
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .wa-modal__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border-subtle);
    border-radius: 50%;
    background: var(--color-bg-warm);
    color: var(--color-forest);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .wa-modal__title {
    font-size: var(--text-xl);
    line-height: 1.25;
    color: var(--color-forest);
    padding-right: var(--space-8);
  }

  .wa-modal__text {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .wa-modal__preview {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border-subtle);
    font-size: var(--text-sm);
    color: var(--color-forest);
    line-height: 1.55;
  }

  .wa-modal__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-1);
  }
</style>
