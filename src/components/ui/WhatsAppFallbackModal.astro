---
import { Check, Copy, X } from '@lucide/astro';
import { isWhatsAppConfigured } from '@/config/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

const configured = isWhatsAppConfigured();
---

{
  !configured && (
    <div
      class="wa-modal"
      id="whatsapp-fallback-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="wa-modal-title"
      hidden
    >
      <div class="wa-modal__backdrop" data-wa-modal-close />
      <div class="wa-modal__dialog">
        <button
          type="button"
          class="wa-modal__close"
          data-wa-modal-close
          aria-label="Fechar aviso"
        >
          <X size={20} />
        </button>

        <div class="wa-modal__badge">
          <WhatsAppIcon size={18} />
          <span>Configuração de WhatsApp pendente</span>
        </div>

        <h3 id="wa-modal-title" class="wa-modal__title">
          WhatsApp pronto para receber o número oficial
        </h3>

        <p class="wa-modal__text">
          O número de atendimento ainda não foi preenchido em <code>src/config/site.ts</code>.
          Assim que o número for informado (com DDI 55 + DDD), este botão abrirá o WhatsApp
          automaticamente com a mensagem abaixo:
        </p>

        <blockquote class="wa-modal__preview" data-wa-modal-message />

        <div class="wa-modal__actions">
          <button type="button" class="btn btn--primary btn--sm" data-wa-copy-message>
            <Copy size={15} data-copy-icon />
            <Check size={15} data-copied-icon hidden />
            <span data-copy-label>Copiar mensagem</span>
          </button>
          <button type="button" class="btn btn--outline-dark btn--sm" data-wa-modal-close>
            Fechar
          </button>
        </div>
      </div>
    </div>
  )
}

<style>
  .wa-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: grid;
    place-items: center;
    padding: var(--space-4);
  }

  .wa-modal[hidden] {
    display: none;
  }

  .wa-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 34, 26, 0.64);
    backdrop-filter: blur(4px);
  }

  .wa-modal__dialog {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 480px;
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .wa-modal__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border-subtle);
    border-radius: 50%;
    background: var(--color-bg-warm);
    color: var(--color-forest);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .wa-modal__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-sage-tint);
    color: var(--color-natural);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .wa-modal__title {
    font-size: var(--text-xl);
    line-height: 1.25;
    color: var(--color-forest);
    padding-right: var(--space-8);
  }

  .wa-modal__text {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .wa-modal__text code {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--color-sage-tint);
    color: var(--color-forest);
    font-size: 0.85em;
  }

  .wa-modal__preview {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border-subtle);
    font-size: var(--text-sm);
    color: var(--color-forest);
    line-height: 1.55;
  }

  .wa-modal__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-1);
  }
</style>
