---
interface Props {
  eyebrow: string;
  titleStart: string;
  titleAccent?: string;
  titleEnd?: string;
  description?: string;
  align?: 'left' | 'center';
  theme?: 'light' | 'dark';
  id?: string;
}

const {
  eyebrow,
  titleStart,
  titleAccent,
  titleEnd,
  description,
  align = 'left',
  theme = 'light',
  id,
} = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`, `section-heading--${theme}`]}>
  <p class:list={['eyebrow', theme === 'dark' && 'eyebrow--light']}>{eyebrow}</p>
  <h2 id={id} class="section-heading__title">
    {titleStart}{' '}
    {titleAccent && <span class="editorial-accent">{titleAccent}</span>}
    {titleEnd && <> {titleEnd}</>}
  </h2>
  {description && <p class="section-heading__desc">{description}</p>}
</header>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 660px;
  }

  .section-heading--center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .section-heading__title {
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: -0.025em;
    color: var(--color-forest);
    text-wrap: balance;
  }

  .section-heading__desc {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    max-width: 56ch;
    text-wrap: pretty;
  }

  .section-heading--dark .section-heading__title {
    color: var(--color-surface);
  }

  .section-heading--dark .section-heading__desc {
    color: var(--color-text-inverse-soft);
  }
</style>
