---
/**
 * Componente comparativo de Antes / Depois.
 * Renderizado automaticamente na seção Portfólio apenas quando houver pares
 * reais cadastrados em `beforeAfterPairs` (`src/data/portfolio.ts`).
 */
import type { BeforeAfterPair } from '@/data/portfolio';
import ResponsivePhoto from './ResponsivePhoto.astro';

interface Props {
  pair: BeforeAfterPair;
}

const { pair } = Astro.props;
---

<article class="before-after" data-before-after>
  <div class="before-after__stage" style="--split: 50%;">
    <div class="before-after__layer before-after__layer--after">
      <ResponsivePhoto
        src={pair.afterImage}
        alt={pair.afterAlt}
        widths={[640, 1024]}
        sizes="(max-width: 768px) 100vw, 800px"
      />
      <span class="before-after__tag before-after__tag--after">Depois</span>
    </div>

    <div class="before-after__layer before-after__layer--before">
      <ResponsivePhoto
        src={pair.beforeImage}
        alt={pair.beforeAlt}
        widths={[640, 1024]}
        sizes="(max-width: 768px) 100vw, 800px"
      />
      <span class="before-after__tag before-after__tag--before">Antes</span>
    </div>

    <div class="before-after__divider" aria-hidden="true"></div>

    <input
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label={`Comparar antes e depois: ${pair.title}`}
      class="before-after__range"
      data-before-after-range
    />
  </div>

  <div class="before-after__footer">
    <h3 class="before-after__title">{pair.title}</h3>
    {pair.caption && <p class="before-after__caption">{pair.caption}</p>}
  </div>
</article>

<style>
  .before-after {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .before-after__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-forest);
  }

  .before-after__layer {
    position: absolute;
    inset: 0;
  }

  .before-after__layer--before {
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  .before-after__tag {
    position: absolute;
    bottom: var(--space-4);
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: rgba(16, 47, 37, 0.8);
    color: var(--color-surface);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .before-after__tag--before {
    left: var(--space-4);
  }

  .before-after__tag--after {
    right: var(--space-4);
  }

  .before-after__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 2px;
    background: var(--color-lime);
    pointer-events: none;
  }

  .before-after__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .before-after__title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-forest);
  }

  .before-after__caption {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>
